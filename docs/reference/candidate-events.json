            { "text": "粮食要省着吃", "outcomes": [ { "weight": 1, "text": "罗莎没再坚持，只是把最大的那颗土豆留给了孩子们。", "effects": [ { "type": "mood", "target": "rosa", "amount": -8 } ] } ] }
        ]
    },
    {
        "id": "ref_perfume_trick",
        "_idea": "R17 潜行与气味（参考：全球进化）",
        "title": "一箱香水",
        "text": "探索队在商场专柜找到一整箱香水。诺拉拿起一瓶闻了闻：“行尸是靠气味找人的。把这个洒在身上，它们也许就闻不到我们了。”",
        "weight": 4,
        "once": true,
        "conditions": { "hasSurvivors": ["nora"] },
        "choices": [
            { "text": "试试看", "outcomes": [
                { "weight": 2, "text": "真的有用！托比浑身喷满香水，从三只行尸身边走过，它们连头都没回。", "effects": [ { "type": "flag", "flag": "scent_masking" }, { "type": "resource", "resource": "parts", "amount": 10 } ] },
                { "weight": 1, "text": "香味太冲，把附近所有的行尸都引了过来。小队狼狈撤回。", "effects": [ { "type": "injure", "survivor": "random" } ] }
            ] },
            { "text": "拿回去换东西", "outcomes": [ { "weight": 1, "text": "下次商队来的时候，一箱香水换了一大袋米。", "effects": [ { "type": "resource", "resource": "food", "amount": 30 } ] } ] }
        ]
    },
    {
        "id": "ref_mutant_serum",
        "_idea": "R28 变异血清（参考：狩魔手记）",
        "title": "实验血清",
        "text": "诺拉在卫生所的冷柜里找到一支贴着“实验品 · 勿用”标签的血清。附带的报告写着：注射者力量和反应速度显著提升，副作用未知。\n汉克把袖子卷了起来：“我老了，拿我试。”",
        "weight": 3,
        "once": true,
        "conditions": { "flags": ["cleared_clinic"], "hasSurvivors": ["hank", "nora"] },
        "choices": [
            { "text": "让汉克注射", "outcomes": [
                { "weight": 1, "text": "汉克发了一夜高烧，第二天一拳打穿了仓库的门板。他盯着自己的手，很久没说话。", "effects": [ { "type": "flag", "flag": "hank_serum" }, { "type": "mood", "target": "all", "amount": -5 } ] },
                { "weight": 1, "text": "汉克抽搐着倒下，差点没挺过来。诺拉守了他两天两夜。", "effects": [ { "type": "injure", "survivor": "hank" }, { "type": "flag", "flag": "hank_serum_failed" } ] }
            ] },
            { "text": "销毁它", "outcomes": [ { "weight": 1, "text": "诺拉把血清倒进了下水道。“有些捷径，”她说，“走上去就回不了头。”", "effects": [ { "type": "mood", "target": "nora", "amount": 5 } ] } ] }
        ]
    },
    {
        "id": "ref_cult_envoy",
        "_idea": "R24 人类敌对势力（参考：蹉跎、最后生还者）",
        "title": "新生会的使者",
        "text": "两个穿白袍的人站在路障外，举着一面画着太阳的旗子：“我们是新生会。末日是神的筛选，只有信徒能活下去。每七天交三十份粮食，你们就受神的庇护。”",
        "weight": 4,
        "once": true,
        "conditions": { "minDay": 4 },
        "choices": [
            { "text": "交粮，不想惹麻烦（30 食物）", "cost": { "food": 30 }, "outcomes": [ { "weight": 1, "text": "使者满意地走了。德里克一脚踢翻了水桶：“这次是粮食，下次呢？”", "effects": [ { "type": "flag", "flag": "cult_tribute" }, { "type": "mood", "target": "derek", "amount": -10 } ] } ] },
            { "text": "“滚。”", "outcomes": [ { "weight": 1, "text": "使者没有生气，只是笑了笑：“神会记住的。”", "effects": [ { "type": "flag", "flag": "cult_defied" }, { "type": "mood", "target": "all", "amount": 5 } ] } ] },
            { "text": "扣下他们，问出老巢在哪", "outcomes": [ { "weight": 1, "text": "年轻的那个吓得全说了。年长的那个，第二天早上不见了。", "effects": [ { "type": "flag", "flag": "cult_location_known" }, { "type": "mood", "target": "sophie", "amount": -8 } ] } ] }
        ]
    },
