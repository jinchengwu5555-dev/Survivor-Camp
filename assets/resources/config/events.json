            { "text": "“……托比，把书给我。”", "outcomes": [ { "weight": 1, "text": "托比委屈地交出了书。第二天，书出现在了玛莎的枕头底下。", "effects": [ { "type": "mood", "target": "toby", "amount": -5 }, { "type": "mood", "target": "martha", "amount": 8 }, { "type": "stat", "stat": "laughs" } ] } ] }
