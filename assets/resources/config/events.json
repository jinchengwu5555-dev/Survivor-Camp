        "choices": [
            { "text": "“就转一圈。”", "outcomes": [ { "weight": 1, "text": "大人们坐在木马上，像孩子一样笑。音乐引来了两只行尸，汉克默默处理掉了，没打扰任何人。", "effects": [ { "type": "mood", "target": "all", "amount": 12 }, { "type": "resource", "resource": "parts", "amount": -3 }, { "type": "stat", "stat": "quiet_moments" } ] } ] },
