{
    "intervalMinutes": 6,
    "moodByKind": { "chat": 1, "gossip": 1, "joke": 2, "worry": -1, "quarrel": -2, "warm": 3 },
    "dialogues": [
        { "id": "md_coffee", "who": ["martha", "derek"], "kind": "quarrel", "lines": [[0, "德里克，你又把机油手往我的围裙上擦了？"], [1, "那是抹布！"], [0, "那是我结婚时候穿的围裙！"]] },
        { "id": "md_soup", "who": ["martha", "derek"], "kind": "chat", "lines": [[1, "今天的汤……还行。"], [0, "“还行”？你喝了三碗。"], [1, "第三碗是替托比喝的。"]] },
        { "id": "md_brother", "who": ["martha", "derek"], "kind": "warm", "conditions": { "flags": ["derek_opened_up"] }, "lines": [[0, "你弟弟的事，我听说了。"], [1, "……嗯。"], [0, "以后晚饭给你多盛一勺。别推，这是命令。"]] },
        { "id": "ms_hands", "who": ["martha", "sophie"], "kind": "warm", "lines": [[0, "丫头，你的手在抖。"], [1, "刚才缝伤口的时候……我怕缝歪了。"], [0, "缝歪了也比不缝强。我当年缝的扣子，现在还结实着呢。"]] },
        { "id": "ms_recipe", "who": ["martha", "sophie"], "kind": "chat", "lines": [[1, "玛莎阿姨，这个汤里放的是什么草？"], [0, "后院的野葱。你给人治病，我给人治胃。"]] },
        { "id": "mt_bike", "who": ["martha", "toby"], "kind": "joke", "lines": [[1, "玛莎，我要是骑车送外卖能再快一点，现在是不是已经升职了？"], [0, "你那车链子一天掉三回，能送到就不错了。"], [1, "那叫“保持神秘”。"]] },
        { "id": "mt_store", "who": ["martha", "toby"], "kind": "chat", "lines": [[0, "你以前老来我店里买薯片，每次都说“记账”。"], [1, "……那账还算数吗？"], [0, "世界末日了，一笔勾销。但你得把地拖了。"]] },
        { "id": "me_husband", "who": ["martha", "ethan"], "kind": "warm", "lines": [[0, "我老头子要是还在，肯定会喜欢你。"], [1, "他是个什么样的人？"], [0, "跟你一样，犟。天塌下来也要先把门锁好。"]] },
        { "id": "me_lily", "who": ["martha", "ethan"], "kind": "worry", "conditions": { "notFlags": ["lily_found"] }, "lines": [[0, "又在看那张照片？"], [1, "夏令营在北边。我每天都在想，她有没有吃上饭。"], [0, "她是你女儿。她会想办法的。"]] },
        { "id": "mh_gun", "who": ["martha", "hank"], "kind": "chat", "conditions": { "hasSurvivors": ["hank"] }, "lines": [[0, "汉克，吃饭的时候能不能把枪放下？"], [1, "不能。"], [0, "……那至少别对着我的锅。"]] },
        { "id": "mr_garden", "who": ["martha", "rosa"], "kind": "chat", "lines": [[1, "屋顶的番茄冒芽了。"], [0, "真的？我三十年没吃过自己种的番茄了。"], [1, "再等一个月。你得忍住别偷摘。"]] },
        { "id": "mn_tongue", "who": ["martha", "nora"], "kind": "quarrel", "lines": [[1, "你这汤盐放多了，高血压的人喝了要出事。"], [0, "那你别喝。"], [1, "……我没说不好喝。"]] },
        { "id": "mj_truck", "who": ["martha", "joe"], "kind": "joke", "lines": [[1, "玛莎，我跟你说，我那辆皮卡跑过四十八个州。"], [0, "上礼拜你说的是五十个。"], [1, "有两个州不承认我去过。"]] },
        { "id": "ml_cookie", "who": ["martha", "lily"], "kind": "warm", "lines": [[0, "莉莉，来，尝尝。最后一包面粉做的饼干。"], [1, "给我爸留一块。"], [0, "早留好了，留了两块。"]] },
        { "id": "de_car", "who": ["derek", "ethan"], "kind": "chat", "lines": [[1, "那辆警车还能修吗？"], [0, "能。你给我三天、两个轮胎、一箱零件，外加别让托比碰它。"]] },
        { "id": "de_brother", "who": ["derek", "ethan"], "kind": "worry", "conditions": { "notFlags": ["derek_opened_up"] }, "lines": [[1, "你最近话少了，德里克。"], [0, "没什么。车的事。"], [1, "……好。想说的时候，我在。"]] },
        { "id": "dt_chain", "who": ["derek", "toby"], "kind": "quarrel", "lines": [[0, "你的车链子又掉了？"], [1, "它自己想休息。"], [0, "拿过来！下次再掉，我把你的车焊在墙上当装饰。"]] },
        { "id": "dt_race", "who": ["derek", "toby"], "kind": "joke", "lines": [[1, "德里克，要是给我的自行车装个马达呢？"], [0, "那你会死得更快。"], [1, "但是会很帅。"]] },
        { "id": "ds_bandage", "who": ["derek", "sophie"], "kind": "warm", "lines": [[1, "别动，你的手在流血。"], [0, "小口子，不碍事。"], [1, "每个说“不碍事”的人，最后都是我给他缝的。"]] },
        { "id": "dh_respect", "who": ["derek", "hank"], "kind": "chat", "lines": [[1, "那把扳手，你用得挺顺手。"], [0, "那把枪，你用得也挺顺手。"], [1, "……嗯。"]] },
        { "id": "dj_engine", "who": ["derek", "joe"], "kind": "quarrel", "lines": [[1, "我这皮卡的发动机，全镇没人比我懂。"], [0, "那你告诉我它为什么每天早上咳嗽。"], [1, "它……有它的性格。"]] },
        { "id": "dj_tools", "who": ["derek", "joe"], "kind": "chat", "lines": [[0, "你车斗里那套套筒扳手，借我用用。"], [1, "拿去。用完擦干净。"], [0, "你还挺讲究。"], [1, "工具就是命。"]] },
        { "id": "dl_radio", "who": ["derek", "lily"], "kind": "warm", "lines": [[1, "德里克叔叔，这台对讲机的天线能再加长吗？"], [0, "能。你想听多远？"], [1, "越远越好。我想听听别的地方还有没有人。"]] },
        { "id": "se_hope", "who": ["sophie", "ethan"], "kind": "worry", "lines": [[0, "伊森，你觉得……外面还有医院吗？"], [1, "不知道。但这里有你。"], [0, "我只是个学生……"], [1, "现在你是医生了。"]] },
        { "id": "st_crush", "who": ["sophie", "toby"], "kind": "joke", "lines": [[1, "苏菲，我好像发烧了。"], [0, "……体温正常。"], [1, "那可能是心跳太快了。"], [0, "去干活。"]] },
        { "id": "sn_mentor", "who": ["sophie", "nora"], "kind": "chat", "lines": [[1, "你缝的针太密了，病人又不是枕头。"], [0, "对、对不起……"], [1, "不用道歉。下次稀一点。你手很稳。"]] },
        { "id": "sn_dog", "who": ["sophie", "nora"], "kind": "joke", "lines": [[0, "诺拉，给人看病和给狗看病有什么区别？"], [1, "狗不会跟我说它上网查过了。"]] },
        { "id": "sh_scared", "who": ["sophie", "hank"], "kind": "warm", "lines": [[0, "汉克先生，您不害怕吗？"], [1, "怕。"], [0, "那您怎么……"], [1, "怕也得站着。站着就不怕了。"]] },
        { "id": "sr_flower", "who": ["sophie", "rosa"], "kind": "warm", "lines": [[1, "给你，窗台上长出来的第一朵花。"], [0, "我……我以为这世界不会再有花了。"]] },
        { "id": "te_jokes", "who": ["toby", "ethan"], "kind": "joke", "lines": [[0, "副警长，你知道行尸为什么不吃小丑吗？"], [1, "不知道。"], [0, "因为味道怪怪的。"], [1, "……回去站岗。"]] },
        { "id": "te_map", "who": ["toby", "ethan"], "kind": "chat", "lines": [[0, "北街那条小巷现在走不了了，墙塌了。"], [1, "记下来。你那张地图比县政府的还准。"], [0, "县政府又不送外卖。"]] },
        { "id": "tl_brothers", "who": ["toby", "leo"], "kind": "joke", "conditions": { "hasSurvivors": ["leo"] }, "lines": [[1, "托比，你骑车的时候会害怕吗？"], [0, "会，所以我骑得特别快。"], [1, "这算什么道理？"], [0, "害怕追不上我。"]] },
        { "id": "th_teach", "who": ["toby", "hank"], "kind": "chat", "lines": [[0, "汉克，教我打枪吧。"], [1, "先学会闭嘴。"], [0, "……这是第一课？"], [1, "嗯。你没通过。"]] },
        { "id": "tj_stories", "who": ["toby", "joe"], "kind": "joke", "lines": [[1, "有一回，我在九十号公路上跟一头熊赛车。"], [0, "谁赢了？"], [1, "熊赢了。但它超速了。"]] },
        { "id": "tr_seeds", "who": ["toby", "rosa"], "kind": "warm", "lines": [[1, "那天在花店门口，要不是你……"], [0, "要不是我路过？我只是送错了一单外卖。"], [1, "那是我这辈子收到最好的一单。"]] },
        { "id": "tn_bite", "who": ["toby", "nora"], "kind": "joke", "lines": [[0, "诺拉，要是我被狗咬了，是找你还是找苏菲？"], [1, "找我。我会先给狗看。"]] },
        { "id": "tli_game", "who": ["toby", "lily"], "kind": "joke", "lines": [[0, "莉莉，玩不玩石头剪刀布？输的人洗碗。"], [1, "好。……你出剪刀我就出石头。"], [0, "你怎么知道我出剪刀？"], [1, "你每次都出剪刀。"]] },
        { "id": "he_war", "who": ["hank", "ethan"], "kind": "chat", "lines": [[1, "你当过兵？"], [0, "很久以前。"], [1, "那时候，比现在难吗？"], [0, "那时候，至少敌人会死透。"]] },
        { "id": "he_trust", "who": ["hank", "ethan"], "kind": "warm", "lines": [[0, "我不信任何人。"], [1, "那你为什么还留在这？"], [0, "……这里的饭还行。"]] },
        { "id": "hn_quiet", "who": ["hank", "nora"], "kind": "chat", "lines": [[1, "你的腿，旧伤？"], [0, "弹片。"], [1, "我给你开点止痛的。"], [0, "不用。疼着，人清醒。"]] },
        { "id": "hl_shoot", "who": ["hank", "lily"], "kind": "warm", "lines": [[1, "汉克爷爷，你能教我吗？"], [0, "你爸同意了？"], [1, "他说要是你答应，他就答应。"], [0, "……那明天早上五点。"]] },
        { "id": "hj_hunt", "who": ["hank", "joe"], "kind": "quarrel", "lines": [[1, "老汉克，我年轻时候也打过猎，一枪一头鹿。"], [0, "哪只手开的枪？"], [1, "右手。"], [0, "你是左撇子。"]] },
        { "id": "rn_herbs", "who": ["rosa", "nora"], "kind": "chat", "lines": [[1, "你种的那些薄荷，能拿来做药吗？"], [0, "能。你要多少？"], [1, "全部。我们快没有胃药了。"]] },
        { "id": "re_future", "who": ["rosa", "ethan"], "kind": "warm", "lines": [[0, "等明年开春，这片停车场可以全种上土豆。"], [1, "你已经在想明年了？"], [0, "种花的人，总是在想明年。"]] },
        { "id": "rj_flowers", "who": ["rosa", "joe"], "kind": "joke", "lines": [[1, "罗莎，给我那车斗种点花吧，开起来香。"], [0, "你的车斗全是机油味，花活不了。"], [1, "那就种仙人掌。"]] },
        { "id": "rl_seed", "who": ["rosa", "lily"], "kind": "warm", "lines": [[0, "这颗种子给你，你自己种。"], [1, "它会长成什么？"], [0, "不告诉你。长出来你就知道了。"]] },
        { "id": "ne_blunt", "who": ["nora", "ethan"], "kind": "chat", "lines": [[0, "你三天没睡整觉了。"], [1, "我没事。"], [0, "你是我见过最会说谎的病人。去睡，这是医嘱。"]] },
        { "id": "nj_teeth", "who": ["nora", "joe"], "kind": "joke", "lines": [[1, "诺拉，我这颗牙老疼。"], [0, "张嘴。……这是马的牙齿吗？"], [1, "那是我吃了三十年汉堡的成就。"]] },
        { "id": "nl_cat", "who": ["nora", "lily"], "kind": "warm", "lines": [[1, "诺拉阿姨，你以前给猫看病吗？"], [0, "看过几千只。"], [1, "那你最喜欢什么猫？"], [0, "不咬人的。"]] },
        { "id": "je_road", "who": ["joe", "ethan"], "kind": "chat", "lines": [[0, "副警长，等这一切过去了，我开车带你去海边。"], [1, "你觉得会过去吗？"], [0, "路总是通到某个地方的。"]] },
        { "id": "jl_driving", "who": ["joe", "lily"], "kind": "joke", "lines": [[1, "老乔，教我开车吧！"], [0, "你脚够得着油门吗？"], [1, "我可以垫两本书。"], [0, "……成交，但别告诉你爸。"]] },
        { "id": "le_night", "who": ["lily", "ethan"], "kind": "warm", "conditions": { "flags": ["lily_found"] }, "lines": [[0, "爸，你每天晚上都在听对讲机吗？"], [1, "每天。"], [0, "我也是。八点整。"], [1, "我知道。我一直都知道。"]] },
        { "id": "le_mom", "who": ["lily", "ethan"], "kind": "worry", "conditions": { "flags": ["lily_found"] }, "lines": [[0, "爸，妈妈会不会也在某个地方？"], [1, "……我不知道，宝贝。"], [0, "那我们就当她在。"]] },
        { "id": "leo_ethan", "who": ["leo", "ethan"], "kind": "chat", "conditions": { "hasSurvivors": ["leo"] }, "lines": [[0, "那天晚上，你为什么开门救我？"], [1, "你在喊救命。"], [0, "就因为这个？"], [1, "就因为这个。"]] },
        { "id": "leo_hank", "who": ["leo", "hank"], "kind": "quarrel", "conditions": { "hasSurvivors": ["leo"] }, "lines": [[0, "我也能上战场！"], [1, "你连枪都拿反了。"], [0, "那是……战术！"]] },

        { "id": "g_snore", "who": ["any", "any"], "about": "any", "kind": "gossip", "lines": [[0, "你听见了吗？昨晚{x}打呼噜，跟拖拉机似的。"], [1, "听见了。我还以为尸潮来了。"]] },
        { "id": "g_sweets", "who": ["any", "any"], "about": "any", "kind": "gossip", "lines": [[0, "我跟你说，{x}的枕头底下藏着一整包糖。"], [1, "真的？你怎么知道？"], [0, "因为我也藏在那儿。"]] },
        { "id": "g_crush", "who": ["any", "any"], "about": "any", "kind": "gossip", "lines": [[0, "你有没有发现，{x}最近洗脸洗得特别勤？"], [1, "嗯……恋爱了？"], [0, "在末日里？"], [1, "末日里也得有人恋爱啊。"]] },
        { "id": "g_diary", "who": ["any", "any"], "about": "any", "kind": "gossip", "lines": [[0, "{x}每天晚上都在一个小本子上写东西。"], [1, "写什么？"], [0, "不知道。有一次我瞄到一眼，写的好像是我们每个人的名字。"]] },
        { "id": "g_food_thief", "who": ["any", "any"], "about": "any", "kind": "gossip", "lines": [[0, "厨房少了两个土豆。"], [1, "我看见{x}半夜往厨房跑。"], [0, "……算了，饿的人不算贼。"]] },
        { "id": "g_talks_to_self", "who": ["any", "any"], "about": "any", "kind": "gossip", "lines": [[0, "{x}今天跟一只行尸说话了，隔着栅栏。"], [1, "说什么了？"], [0, "“别再来了，我们也不容易。”"]] },
        { "id": "g_old_job", "who": ["any", "any"], "about": "any", "kind": "gossip", "lines": [[0, "你知道{x}以前是干什么的吗？"], [1, "不知道，没问过。"], [0, "我也不知道。我觉得是间谍。"], [1, "你想多了。"]] },
        { "id": "g_singing", "who": ["any", "any"], "about": "any", "kind": "gossip", "lines": [[0, "{x}洗澡的时候唱歌，唱得还挺好听。"], [1, "唱的什么？"], [0, "一首我没听过的老歌。唱到一半就哭了。"]] },
        { "id": "g_nightwatch", "who": ["any", "any"], "about": "any", "kind": "gossip", "lines": [[0, "昨晚{x}守夜的时候睡着了。"], [1, "嘘——别让别人知道。"], [0, "我替他站了一小时。"]] },
        { "id": "g_letter", "who": ["any", "any"], "about": "any", "kind": "gossip", "lines": [[0, "{x}每个星期都写一封信，写完就烧掉。"], [1, "写给谁的？"], [0, "不知道。烧之前会念一遍收信人的名字，每次都不一样。"]] },
        { "id": "g_hair", "who": ["any", "any"], "about": "any", "kind": "gossip", "lines": [[0, "你看{x}的新发型没？"], [1, "看了。谁剪的？"], [0, "自己拿菜刀剪的。"]] },
        { "id": "g_cards", "who": ["any", "any"], "about": "any", "kind": "gossip", "lines": [[0, "{x}打牌出老千。"], [1, "赌的是什么？"], [0, "明天谁洗碗。"], [1, "那是得管管。"]] },
        { "id": "g_pet", "who": ["any", "any"], "about": "any", "kind": "gossip", "lines": [[0, "{x}在仓库后面偷偷喂一只老鼠。"], [1, "老鼠？"], [0, "还给它起了名字，叫“警长”。"]] },
        { "id": "g_birthday", "who": ["any", "any"], "about": "any", "kind": "warm", "lines": [[0, "我听说，下个礼拜是{x}的生日。"], [1, "那我们偷偷准备点什么吧。"], [0, "我去找蜡烛，你去求玛莎做蛋糕。"]] },
        { "id": "g_brave", "who": ["any", "any"], "about": "any", "kind": "gossip", "lines": [[0, "上次探索，{x}一个人挡住了三只行尸。"], [1, "真的假的？"], [0, "真的。回来以后吐了一晚上，但是真的。"]] },
        { "id": "g_quarrel", "who": ["any", "any"], "about": "any", "kind": "quarrel", "lines": [[0, "{x}今天又抢我的位置。"], [1, "什么位置？"], [0, "离火最近的那张椅子！"]] },

        { "id": "c_weather", "who": ["any", "any"], "kind": "chat", "lines": [[0, "今天风好大。"], [1, "风大好，味儿都吹走了。"]] },
        { "id": "c_burger", "who": ["any", "any"], "kind": "chat", "lines": [[0, "你最想吃什么？"], [1, "一个真正的汉堡。两片牛肉，加双份芝士。"], [0, "别说了，我口水都下来了。"]] },
        { "id": "c_shower", "who": ["any", "any"], "kind": "chat", "lines": [[0, "你还记得热水澡是什么感觉吗？"], [1, "不记得了。别提醒我。"]] },
        { "id": "c_phone", "who": ["any", "any"], "kind": "worry", "lines": [[0, "我手机里还存着我妈的语音。"], [1, "还有电？"], [0, "没了。但我记得她说的每一个字。"]] },
        { "id": "c_stars", "who": ["any", "any"], "kind": "chat", "lines": [[0, "停电以后，星星多了好多。"], [1, "星星一直都在，是以前的灯太亮了。"]] },
        { "id": "c_tv", "who": ["any", "any"], "kind": "joke", "lines": [[0, "我好想看电视。"], [1, "看什么？"], [0, "什么都行。天气预报都行。"], [1, "天气预报：明天还是末日，局部有行尸。"]] },
        { "id": "c_school", "who": ["any", "any"], "kind": "joke", "lines": [[0, "至少再也不用交税了。"], [1, "也不用上班打卡了。"], [0, "……可我现在每天比上班还累。"]] },
        { "id": "c_dream", "who": ["any", "any"], "kind": "worry", "lines": [[0, "我昨晚梦见被咬了。"], [1, "我也经常做这个梦。"], [0, "醒过来的时候，我摸了半天胳膊。"]] },
        { "id": "c_music", "who": ["any", "any"], "kind": "chat", "lines": [[0, "你说，世界上最后一首歌会是什么？"], [1, "不知道。反正我们唱的不算，太难听了。"]] },
        { "id": "c_coffee", "who": ["any", "any"], "kind": "chat", "lines": [[0, "要是有杯咖啡就好了。"], [1, "上次那罐咖啡，你一个人喝了一半。"], [0, "那是为了守夜！"]] },
        { "id": "c_socks", "who": ["any", "any"], "kind": "joke", "lines": [[0, "我的袜子只剩一只了。"], [1, "另一只呢？"], [0, "上次跑的时候，被行尸扯走了。它现在穿着我的袜子。"]] },
        { "id": "c_rain", "who": ["any", "any"], "kind": "chat", "lines": [[0, "下雨了，把桶都摆出去接水。"], [1, "已经摆了。连玛莎的锅都摆出去了。"]] },
        { "id": "c_count", "who": ["any", "any"], "kind": "worry", "lines": [[0, "你数过吗？我们搬进来多少天了？"], [1, "数过。数着数着就不敢数了。"]] },
        { "id": "c_first_day", "who": ["any", "any"], "kind": "worry", "lines": [[0, "你还记得第一天吗？"], [1, "记得。我在超市的冰柜后面躲了一整夜。"], [0, "我也是……原来那个人是你？"]] },
        { "id": "c_names", "who": ["any", "any"], "kind": "chat", "lines": [[0, "我们是不是该给营地起个名字？"], [1, "叫“还活着”怎么样？"], [0, "……挺好的。"]] },
