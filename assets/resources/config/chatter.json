        { "id": "c_silence", "who": ["any", "any"], "kind": "worry", "lines": [[0, "今天太安静了。"], [1, "安静不好吗？"], [0, "安静的时候，我就会想起以前的事。"]] },
        { "id": "c_birds", "who": ["any", "any"], "kind": "chat", "lines": [[0, "今天早上有鸟在叫。"], [1, "好久没听见了。"], [0, "说明附近安全了一点吧。"]] },
        { "id": "c_old_life", "who": ["any", "any"], "kind": "chat", "lines": [[0, "以前我最烦周一早上。"], [1, "现在呢？"], [0, "现在我什么都愿意换一个周一早上。"]] },
        { "id": "c_help", "who": ["any", "any"], "kind": "warm", "lines": [[0, "谢谢你昨天拉了我一把。"], [1, "换了你也会拉我的。"], [0, "那可不一定，我跑得比你快。"], [1, "……滚。"]] },
        { "id": "c_cold", "who": ["any", "any"], "kind": "chat", "lines": [[0, "晚上越来越冷了。"], [1, "得多攒点柴火。"], [0, "明天我去拆那排旧货架。"]] },
